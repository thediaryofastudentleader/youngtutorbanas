{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "installCommand": "npm ci --registry=https://registry.npmjs.org",
  "builds": [
    {
      "src": "package.json",
      "use": "@vercel/static-build",
      "config": { "distDir": "dist/public" }
    }
  ],
  "rewrites": [
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
